# The web UI's single downstream dependency: the medialab-orchestrator gateway.
# In Docker, the host is the service name on the shared compose network.
ORCHESTRATOR_URL=http://medialab-orchestrator:8000
ORCHESTRATOR_API_KEY=
# One shared password for the page. Required; the service refuses to start
# without it. Any strong string.
WEB_PASSWORD=
# Signs the session cookie. Any long random string; rotating it logs everyone out.
WEB_SECRET_KEY=
SESSION_MAX_AGE_SECONDS=2592000
API_HOST=0.0.0.0
API_PORT=8080
GATEWAY_TIMEOUT_SECONDS=30.0
TORRENT_RESULTS_PER_RESOLUTION=10
LOG_LEVEL=INFO
